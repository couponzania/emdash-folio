---
// The chart block on the page. Everything is drawn on the server: bars as HTML rows, a line as
// an SVG plot stretched to its box with HTML labels over it (text never shrinks on phones), a
// donut as SVG arcs. Every chart carries its numbers as a data table, its description for
// screen readers, and its source. A chart that can't be drawn says why instead.
import "../styles/folio.css";
import "../styles/charts-more.css";
import "../styles/charts-extra.css";
import ExtraCharts from "./ExtraCharts.astro";
import { comboModel, funnelModel, heatmapModel, histogramModel, scatterModel, waterfallModel } from "./extra-rules.ts";
import { areaModel, columnModel, compareModel, stackModel } from "./more-rules.ts";
import { barModel, chartSpec, donutModel, formatValue, lineModel } from "./rules.ts";
import type { ChartSpec } from "./rules.ts";

interface Props {
	node: Record<string, unknown> & { _type: string; _key: string };
}

const spec = chartSpec(Astro.props.node);
const MODELS = {
	bar: barModel,
	line: lineModel,
	donut: donutModel,
	column: columnModel,
	stacked: stackModel,
	area: areaModel,
	compare: compareModel,
	scatter: scatterModel,
	histogram: histogramModel,
	heatmap: heatmapModel,
	funnel: funnelModel,
	waterfall: waterfallModel,
	combo: comboModel,
};
const model = !spec.ok ? spec : (MODELS[spec.kind] as (s: ChartSpec) => ReturnType<(typeof MODELS)[keyof typeof MODELS]>)(spec);
if (!model.ok) console.warn(`[folio] chart ${Astro.props.node._key} not drawn: ${model.reason}`);
const bar = spec.ok && spec.kind === "bar" && model.ok ? (model as Extract<ReturnType<typeof barModel>, { ok: true }>) : null;
const line = spec.ok && spec.kind === "line" && model.ok ? (model as Extract<ReturnType<typeof lineModel>, { ok: true }>) : null;
const donut = spec.ok && spec.kind === "donut" && model.ok ? (model as Extract<ReturnType<typeof donutModel>, { ok: true }>) : null;
type Ok<F extends (...a: never[]) => unknown> = Extract<ReturnType<F>, { ok: true }>;
const pick = <F extends (...a: never[]) => unknown>(kind: string) => (spec.ok && spec.kind === kind && model.ok ? (model as Ok<F>) : null);
const cols = pick<typeof columnModel>("column");
const stack = pick<typeof stackModel>("stacked");
const area = pick<typeof areaModel>("area");
const compare = pick<typeof compareModel>("compare");
const scatter = pick<typeof scatterModel>("scatter");
const histogram = pick<typeof histogramModel>("histogram");
const heatmap = pick<typeof heatmapModel>("heatmap");
const funnel = pick<typeof funnelModel>("funnel");
const waterfall = pick<typeof waterfallModel>("waterfall");
const combo = pick<typeof comboModel>("combo");
const legend = bar?.legend ?? line?.legend ?? stack?.legend ?? area?.legend ?? compare?.legend ?? scatter?.legend ?? combo?.legend ?? cols?.legend ?? [];
const unitNote = line?.unitNote || area?.unitNote || cols?.unitNote || scatter?.unitNote || waterfall?.unitNote || "";
const unitHead = spec.ok && spec.yUnit ? `${spec.y} (${spec.yUnit})` : spec.ok ? spec.y : "";
const hasFoot = spec.ok && (spec.caption || spec.source);
---

{
	!model.ok ? (
		<p class="folio folio-chart__error">{`Chart not shown: ${model.reason}`}</p>
	) : (
		spec.ok && (
			<figure class:list={["folio", "folio-chart", `folio-chart--${spec.kind}`]}>
				{spec.title && <p class="folio-chart__title">{spec.title}</p>}

				{legend.length > 0 && (
					<ul class="folio-chart__legend" aria-hidden="true">
						{legend.map((l) => (
							<li>
								<span class="folio-swatch" data-slot={l.slot} />
								{l.name}
							</li>
						))}
					</ul>
				)}

				{bar && (
					<div class="folio-bars" role="img" aria-label={spec.alt}>
						{bar.rows.map((row) => (
							<div class="folio-bars__row" aria-hidden="true">
								<span class="folio-bars__label">{row.label}</span>
								<span class="folio-bars__set">
									{row.bars.map((b) =>
										bar.zero === undefined ? (
											<span class="folio-bars__bar">
												<span class="folio-bars__fill" data-slot={b.slot} style={`--folio-to:${b.percent}%`} />
												<span class="folio-bars__val">{b.text}</span>
											</span>
										) : (
											<span class="folio-bars__bar folio-bars__bar--div">
												<span class="folio-bars__track">
													<span class="folio-bars__zero" style={`left:${bar.zero}%`} />
													<span class="folio-bars__fill" data-slot={b.slot} style={`left:${b.left}%;width:${b.width}%`} />
													<span class:list={["folio-bars__val", b.value < 0 && "is-neg"]} style={`left:${b.value < 0 ? b.left : (b.left ?? 0) + (b.width ?? 0)}%`}>
														{b.text}
													</span>
												</span>
											</span>
										),
									)}
								</span>
							</div>
						))}
					</div>
				)}

				{unitNote && (
					<p class="folio-line__unit" aria-hidden="true">
						{unitNote}
					</p>
				)}

				{line && (
					<div class="folio-line" role="img" aria-label={spec.alt}>
						<div class="folio-line__y" aria-hidden="true">
							{line.yTicks.map((t) => (
								<span style={`top:${t.percent}%`}>{t.label}</span>
							))}
						</div>
						<div class="folio-line__plot" aria-hidden="true">
							<svg viewBox="0 0 1000 1000" preserveAspectRatio="none" focusable="false">
								{line.yTicks.map((t) => (
									<line class="folio-line__grid" x1="0" x2="1000" y1={t.percent * 10} y2={t.percent * 10} vector-effect="non-scaling-stroke" />
								))}
								{line.series.map((s) => s.segments.map((points) => <polyline class="folio-line__path" data-slot={s.slot} points={points} vector-effect="non-scaling-stroke" />))}
							</svg>
							{line.series.map((s) => s.points.map((p) => <span class="folio-line__dot" data-slot={s.slot} style={`left:${p.left}%;top:${p.top}%`} title={`${s.name ? `${s.name}, ` : ""}${p.label}: ${p.text}`} />))}
						</div>
						<div class="folio-line__x" aria-hidden="true">
							{line.xLabels.map((l) => (
								<span class:list={[l.minor && "is-minor"]} style={`left:${l.percent}%`}>{l.label}</span>
							))}
						</div>
					</div>
				)}

				{area && (
					<div class="folio-line" role="img" aria-label={spec.alt}>
						<div class="folio-line__y" aria-hidden="true">
							{area.yTicks.map((t) => (
								<span style={`top:${t.percent}%`}>{t.label}</span>
							))}
						</div>
						<div class="folio-line__plot" aria-hidden="true">
							<svg viewBox="0 0 1000 1000" preserveAspectRatio="none" focusable="false">
								{area.yTicks.map((t) => (
									<line class="folio-line__grid" x1="0" x2="1000" y1={t.percent * 10} y2={t.percent * 10} vector-effect="non-scaling-stroke" />
								))}
								{area.layers.map((l) => (
									<polygon class="folio-area__fill" data-slot={l.slot} points={l.polygon} />
								))}
								{area.layers.map((l) => (
									<polyline class="folio-line__path" data-slot={l.slot} points={l.line} vector-effect="non-scaling-stroke" />
								))}
							</svg>
						</div>
						<div class="folio-line__x" aria-hidden="true">
							{area.xLabels.map((l) => (
								<span class:list={[l.minor && "is-minor"]} style={`left:${l.percent}%`}>{l.label}</span>
							))}
						</div>
					</div>
				)}

				{cols && (
					<div class="folio-cols" role="img" aria-label={spec.alt}>
						<div class="folio-line__y" aria-hidden="true">
							{cols.yTicks.map((t) => (
								<span style={`top:${t.percent}%`}>{t.label}</span>
							))}
						</div>
						<div class="folio-cols__plot" aria-hidden="true">
							{cols.yTicks.map((t) => (
								<span class="folio-cols__grid" style={`top:${t.percent}%`} />
							))}
							{cols.columns.map((c) => (
								<div class="folio-cols__col" style={`--folio-to:${c.percent}%`} title={`${c.label}: ${c.text}`}>
									<span>{c.text}</span>
								</div>
							))}
							{cols.groups.map((g) => (
								<div class="folio-cols__group">
									{g.bars.map((b) => (
										<div class="folio-cols__col" data-slot={b.slot} style={`--folio-to:${b.percent}%`} title={`${g.label}, ${b.series}: ${b.text}`}>
											<span>{b.text}</span>
										</div>
									))}
								</div>
							))}
						</div>
						<div class="folio-cols__x" aria-hidden="true">
							{(cols.groups.length ? cols.groups : cols.columns).map((c) => (
								<span>{c.label}</span>
							))}
						</div>
					</div>
				)}

				{stack && (
					<div class="folio-stack" role="img" aria-label={spec.alt}>
						{stack.rows.map((r) => (
							<div class="folio-stack__row" aria-hidden="true">
								<span class="folio-stack__label">{r.label}</span>
								<span class="folio-stack__bar" style={`--folio-to:${r.percent}%`}>
									{r.segments.map((g) => (
										<span class="folio-stack__seg" data-slot={g.slot} style={`--folio-w:${g.width}%`} title={`${g.series}: ${g.text}`} />
									))}
								</span>
								{r.total && <span class="folio-stack__total">{r.total}</span>}
							</div>
						))}
					</div>
				)}

				{compare && (
					<div class="folio-dumb" role="img" aria-label={spec.alt}>
						{compare.rows.map((r) => (
							<div class="folio-dumb__row" aria-hidden="true">
								<span class="folio-dumb__label">{r.label}</span>
								<span class="folio-dumb__track">
									<span class="folio-dumb__link" style={`--folio-from:${Math.min(r.from.at, r.to.at)}%;--folio-to:${Math.max(r.from.at, r.to.at)}%`} />
									<span class="folio-dumb__dot" data-slot="6" style={`--folio-at:${r.from.at}%`}>
										<b>{r.from.text}</b>
									</span>
									<span class="folio-dumb__dot" data-slot="1" style={`--folio-at:${r.to.at}%`}>
										<b>{r.to.text}</b>
									</span>
								</span>
							</div>
						))}
					</div>
				)}

				{donut && (
					<div class="folio-donut">
						<svg viewBox="0 0 200 200" role="img" aria-label={spec.alt} class="folio-donut__ring">
							{donut.slices.map((s) => (
								<path d={s.path} data-slot={s.slot} fill-rule="evenodd" />
							))}
							<text x="100" y="104" text-anchor="middle" class="folio-donut__big" aria-hidden="true">
								{donut.top.percent}
							</text>
							{donut.top.label.length <= 14 && (
								<text x="100" y="124" text-anchor="middle" class="folio-donut__small" aria-hidden="true">
									{donut.top.label}
								</text>
							)}
						</svg>
						<ul class="folio-donut__legend" aria-hidden="true">
							{donut.slices.map((s) => (
								<li>
									<span class="folio-swatch" data-slot={s.slot} />
									<span class="folio-donut__name">{s.label}</span>
									<span class="folio-donut__pct">{s.percent}</span>
								</li>
							))}
						</ul>
					</div>
				)}

				{spec.ok && (scatter || histogram || heatmap || funnel || waterfall || combo) && (
					<ExtraCharts alt={spec.alt} scatter={scatter} histogram={histogram} heatmap={heatmap} funnel={funnel} waterfall={waterfall} combo={combo} yName={spec.y} />
				)}

				<details class="folio-chart__data">
					<summary>Data table</summary>
					<div class="folio-chart__scroll">
						{histogram ? (
							<table>
								<thead>
									<tr>
										<th scope="col">{`${spec.y} from`}</th>
										<th scope="col">to</th>
										<th scope="col">Count</th>
									</tr>
								</thead>
								<tbody>
									{histogram.bins.map((b) => (
										<tr>
											<th scope="row">{formatValue(b.from, spec.yUnit)}</th>
											<td>{formatValue(b.to, spec.yUnit)}</td>
											<td>{b.count}</td>
										</tr>
									))}
								</tbody>
							</table>
						) : (
						<table>
							<thead>
								<tr>
									<th scope="col">{spec.x}</th>
									{spec.series && <th scope="col">{spec.series}</th>}
									<th scope="col">{unitHead}</th>
									{spec.y2 && <th scope="col">{spec.y2Unit ? `${spec.y2} (${spec.y2Unit})` : spec.y2}</th>}
									{donut && <th scope="col">Share</th>}
								</tr>
							</thead>
							<tbody>
								{spec.rows.map((r, i) => (
									<tr>
										<th scope="row">{typeof r[spec.x] === "number" && spec.xUnit ? formatValue(r[spec.x] as number, spec.xUnit) : String(r[spec.x] ?? "")}</th>
										{spec.series && <td>{String(r[spec.series] ?? "")}</td>}
										<td>{typeof r[spec.y] === "number" ? formatValue(r[spec.y] as number, spec.yUnit) : "No data"}</td>
										{spec.y2 && <td>{formatValue(r[spec.y2] as number, spec.y2Unit)}</td>}
										{donut && <td>{donut.slices[i]?.percent}</td>}
									</tr>
								))}
							</tbody>
						</table>
						)}
					</div>
				</details>

				{hasFoot && (
					<figcaption class="folio-chart__foot">
						{spec.caption && <span class="folio-chart__caption">{spec.caption}</span>}
						{spec.source && (
							<span class="folio-chart__source">
								Source:{" "}
								{spec.source.href ? (
									<a href={spec.source.href} rel={/^https?:/i.test(spec.source.href) ? "noopener" : undefined}>
										{spec.source.name}
									</a>
								) : (
									spec.source.name
								)}
							</span>
						)}
					</figcaption>
				)}
			</figure>
		)
	)
}
